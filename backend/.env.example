# DocDigitizer Environment Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for AI extraction)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Upload/Output directories (default: relative to backend/)
# UPLOAD_DIR=uploads
# OUTPUT_DIR=outputs

# Tesseract OCR path (default: C:\Program Files\Tesseract-OCR\tesseract.exe)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
